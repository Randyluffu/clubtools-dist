// Technique
//

technique T0
{
    pass P0
    {
        VertexShader = compile vs_2_0 VertexShaderImpl();
        PixelShader  = compile ps_2_0 PixelShaderImpl();
    }
}

␀␀␀␀␀␀␀//
// End of Dynamic Shader Code
//
